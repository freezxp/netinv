# Single-host deployment, tls mode (the default): nginx terminates HTTPS,
# serves the SPA and proxies /api to the api service (in k8s the ingress does
# this — doc 19). Port 80 is a doormat that points at 443, nothing more.
#
# This is a template, not a config: the nginx image substitutes
# ${TLS_PORT_SUFFIX} at start-up. Only environment variables are substituted,
# so nginx's own $host and $request_uri survive untouched. The snippets it
# includes are plain configs and are never templated.
#
# The other mode is frontend-http.conf.template — see doc 20 §12.4. Both
# include the same app.conf, so the SPA, the /api proxy and the security
# headers are identical between them by construction.

# Plain HTTP exists only to send browsers to HTTPS. It is not a second way in.
server {
    listen 80;
    server_name _;

    # ACME http-01 stays reachable, so swapping the self-signed certificate for
    # a Let's Encrypt one does not require editing this file first.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        # ${TLS_PORT_SUFFIX} is substituted at container start by the nginx
        # image's envsubst step. It carries the *published* HTTPS port, which
        # nginx cannot know: it listens on 443 inside the container while the
        # host may map that to anything. Without it the redirect sends browsers
        # to https://host/ — port 443, where nothing is listening — and the
        # only symptom is a connection that hangs after a working login page.
        #
        # 307 rather than 308, and no-store rather than the default: a
        # *permanent* redirect carrying a port number is a trap. Switch the
        # deployment to NETINV_FRONTEND_MODE=http later and every browser that
        # saw the 308 keeps redirecting itself to :8443 — a port the new front
        # end may not publish — without ever asking this server again. The
        # symptom is a site that is unreachable for the people who used it
        # before and fine for everyone else, and no request in the access log
        # to show for it. HSTS above is what durably pins HTTPS; this redirect
        # only needs to route the current hit.
        add_header Cache-Control "no-store" always;
        return 307 https://$host${TLS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    include /etc/nginx/snippets/tls-params.conf;
    include /etc/nginx/snippets/app.conf;
}
