# Copy to .env and fill in. Generate keys with: openssl rand -base64 32
PG_PASSWORD=netinv-dev
RABBIT_PASSWORD=netinv-dev
NETINV_MASTER_KEY=CHANGE_ME_base64_32_bytes
NETINV_JWT_SIGNING_KEY=CHANGE_ME_base64_32_bytes
NETINV_ADMIN_PASSWORD=CHANGE_ME_admin_password
NETINV_UI_URL=http://localhost:8090
# The dev compose data tier uses these passwords; a real deploy points PG_DSN
# and RABBIT at your managed data tier instead.
