# Copy to .env and fill in. Generate keys with: openssl rand -base64 32
PG_PASSWORD=netinv-dev
RABBIT_PASSWORD=netinv-dev
CH_PASSWORD=netinv-dev
NETINV_MASTER_KEY=CHANGE_ME_base64_32_bytes
NETINV_JWT_SIGNING_KEY=CHANGE_ME_base64_32_bytes
NETINV_ADMIN_PASSWORD=CHANGE_ME_admin_password
NETINV_UI_URL=http://localhost:8090
# The dev compose data tier uses these passwords; a real deploy points PG_DSN
# and RABBIT at your managed data tier instead.

# How the frontend serves the app.
#
#   tls  (default) nginx terminates HTTPS on 8443 and port 8090 does nothing
#        but redirect to it. TLS is the way in.
#   http port 8090 serves the app directly as well, so a TLS-terminating proxy
#        in front — a Cloudflare tunnel, a load balancer, an existing reverse
#        proxy — can reach an origin that presents no certificate of its own.
#        8443 keeps working alongside it.
#
# http mode puts the login POST and the session cookie in cleartext on the hop
# between that proxy and this host, so it is only defensible when the hop is
# trusted: a proxy on this same host, or a segment you would already run plain
# HTTP across. Doc 20 §12.4 has the full trade-off.
NETINV_FRONTEND_MODE=tls

# How long metrics are kept, and how far back the UI may query. VictoriaMetrics
# duration syntax: 90d, 18mo, 2y. Both the metrics store and the API read this,
# so they cannot drift apart — an API ceiling below retention silently hides
# data you are paying to keep.
#
# The default is 2y so the full range selector works out of the box: the presets
# are Cacti's and run to two years, and a shorter default would ship a menu
# whose longer half is greyed out on a fresh install.
#
# Cost scales with device count, not time: measured at roughly 75 MB per device
# per year (0.83 bytes/sample after compression). Two years is therefore ~2 GB
# for 13 devices, ~15 GB for 100, ~75 GB for 500. Lower it if your fleet is
# large or the disk is small — VictoriaMetrics stops accepting writes when the
# disk fills, which stops collection.
#
# Raising it only affects data collected from then on; expired samples are gone.
#
# Note doc 04's reference architecture keeps raw data 90 days and serves longer
# views from 5m/1h rollups. Those rollups are not implemented, so this keeps raw
# samples for the whole period — cheap for a small fleet, expensive for a large
# one.
NETINV_VM_RETENTION=2y

# Raw flow storage (ADR-026, doc 34 §7): days of individual flows, and of the
# hourly rollup that serves longer ranges. Flow disk use grows with traffic,
# not device count — doc 34 §7.3 has the arithmetic.
NETINV_FLOW_RAW_RETENTION=30
NETINV_FLOW_ROLLUP_RETENTION=365
