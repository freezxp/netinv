# Copy to .env and fill in. Generate keys with: openssl rand -base64 32
PG_PASSWORD=netinv-dev
RABBIT_PASSWORD=netinv-dev
NETINV_MASTER_KEY=CHANGE_ME_base64_32_bytes
NETINV_JWT_SIGNING_KEY=CHANGE_ME_base64_32_bytes
NETINV_ADMIN_PASSWORD=CHANGE_ME_admin_password
NETINV_UI_URL=http://localhost:8090
# The dev compose data tier uses these passwords; a real deploy points PG_DSN
# and RABBIT at your managed data tier instead.

# How long metrics are kept, and how far back the UI may query. VictoriaMetrics
# duration syntax: 90d, 18mo, 2y. Both the metrics store and the API read this,
# so they cannot drift apart — an API ceiling below retention silently hides
# data you are paying to keep.
#
# Cost scales with device count, not time: measured at roughly 75 MB per device
# per year (0.83 bytes/sample after compression). Raising this only affects data
# collected from now on; it cannot recover samples already expired.
#
# Note the reference architecture in doc 04 keeps raw data 90 days and serves
# longer views from 5m/1h rollups. Those rollups are not implemented, so a long
# retention here stores raw samples for the whole period. That is cheap for a
# small fleet and expensive for a large one.
NETINV_VM_RETENTION=90d
