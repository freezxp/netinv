<!--
  ClickHouse settings for NetInv's raw flow store (ADR-026, doc 34 §7).

  ClickHouse's defaults assume a dedicated server. Here it shares one host with
  the rest of the stack, so its memory ceiling and caches are capped, and the
  system logs it keeps about itself — query, trace, metric and part logs, which
  write continuously and grow without a TTL — are switched off. They are a
  ClickHouse operator's diagnostics, not NetInv data.
-->
<clickhouse>
    <max_server_memory_usage>2147483648</max_server_memory_usage>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>

    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <session_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <s3queue_log remove="1"/>
    <query_metric_log remove="1"/>

    <logger>
        <level>warning</level>
    </logger>
</clickhouse>
