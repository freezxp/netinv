# Go
backend/bin/
*.test
*.out

# Node
node_modules/
frontend/dist/

# Local env & scratch
.env
.env.*
scratch/

# Playwright run artefacts
frontend/test-results/
frontend/playwright-report/

# Editor/OS
.DS_Store
.idea/
.vscode/
*.tsbuildinfo
*.env

# ...but keep example env templates
!*.env.example
!.env.example

# TLS material for the single-host deployment. Generated per host by
# deploy/compose-app/make-cert.sh, or replaced with a real certificate. A
# private key must never reach this repository — it is public (ADR-019).
deploy/compose-app/certs/
*.key
*.pem

# Deployment backups. scripts/backup.sh and deploy/compose-app/upgrade.sh write
# here by default, and the contents are a full dump of a live deployment — user
# accounts and password hashes, the audit log, device inventory with management
# addresses, refresh tokens. This repository is public (ADR-019), so none of it
# may ever be committed. Two of these files reached origin/main once already.
backups/
